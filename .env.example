PORT=4300
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
REDIS_URL="rediss://default:[YOUR-PASSWORD]@[YOUR-UPSTASH-HOST]:6379"
# Optional: dedicated database for `npm test`. If unset, the suite derives one
# automatically (DATABASE_URL's name + "_test", e.g. postgres -> postgres_test),
# creates it on the same server, and syncs the schema there. The original
# database is never touched by tests.
# TEST_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/accounting_test"
